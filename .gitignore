# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
**/build/
**/.gradle/
**/.kotlin/
**/.cxx/
**/Pods/
**/Flutter/ephemeral/
**/flutter/ephemeral/
**/xcuserdata/
/coverage/

# Environment-specific configuration and secrets
.env
.env.*
!.env.example
lib/config/env.g.dart

# Firebase credentials and generated platform configuration. `firebase.json`
# contains only shared project metadata and is deliberately kept in Git.
# Generate the files below locally with `flutterfire configure`.
lib/firebase_options.dart
**/google-services.json
**/GoogleService-Info.plist
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# Generated Dart and platform integration files.
# Their source files remain versioned; regenerate them after cloning.
lib/l10n/app_localizations*.dart
lib/**/*.freezed.dart
lib/**/*.g.dart
**/GeneratedPluginRegistrant.*
**/generated_plugin_registrant.*
**/generated_plugins.cmake

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
